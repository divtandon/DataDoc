# Requires the Claude Code CLI installed and logged in (`claude login`) with
# an active Pro/Max subscription -- no ANTHROPIC_API_KEY needed. DataDoc
# drives it via the Claude Agent SDK.

# DataHub MCP Server connection (DataHub Cloud or self-hosted)
# Streamable HTTP endpoint, e.g. https://<tenant>.acryl.io/api/mcp
# For local dev via scripts/run_local_datahub_mcp.py, use http://127.0.0.1:8000/mcp
DATAHUB_MCP_URL=
DATAHUB_MCP_TOKEN=

# Optional: pin a specific model (defaults to the Claude Code CLI's default)
DATADOC_MODEL=
